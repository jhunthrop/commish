{
	"name": "web",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "wrangler types && node --env-file-if-exists=.env scripts/check-glyphs.ts && node scripts/well-known.ts && vite build",
		"preview": "wrangler dev .svelte-kit/cloudflare/_worker.js --port 4173",
		"prepare": "wrangler types && svelte-kit sync || echo ''",
		"check": "wrangler types && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint . --concurrency=auto",
		"test": "node --test 'src/**/*.test.ts' 'scripts/**/*.test.ts'",
		"format": "prettier --write .",
		"gen": "wrangler types",
		"screenshots": "node scripts/screenshots.ts",
		"lighthouse": "lhci autorun && npm run lighthouse:sheet",
		"lighthouse:sheet": "lhci autorun --config=lighthouserc.sheet.cjs",
		"fonts": "node scripts/subset-fonts.ts && prettier --write src/lib/ui/fonts/ui.css",
		"preview:static": "node scripts/serve-built.ts",
		"glyphs": "node --env-file-if-exists=.env scripts/check-glyphs.ts",
		"standin": "node --env-file-if-exists=.env scripts/run-from-mock-data.ts",
		"shots": "node --env-file-if-exists=.env scripts/shots.ts",
		"measure:sheet": "node scripts/measure-sheet.ts",
		"measure:page": "node scripts/measure-page-js.ts",
		"gen:shared": "node ../shared/scripts/gen-tokens.ts && node ../shared/scripts/gen-words.ts && node ../shared/scripts/export-fixtures.ts && node ../shared/scripts/gen-mark.ts && node ../shared/scripts/export-parity.ts && node ../shared/scripts/export-run.ts && node ../shared/scripts/export-record.ts && node ../apps/ios/scripts/gen-openapi.ts",
		"check:shared": "node ../shared/scripts/check-gen.ts"
	},
	"devDependencies": {
		"@capsizecss/metrics": "^4.3.0",
		"@capsizecss/unpack": "^4.0.1",
		"@eslint/js": "^10.0.1",
		"@jridgewell/sourcemap-codec": "^1.6.0",
		"@lhci/cli": "^0.15.1",
		"@sveltejs/adapter-cloudflare": "^8.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@types/compression": "^1.8.1",
		"@types/node": "^24",
		"@types/serve-handler": "^6.1.4",
		"@types/subset-font": "^2.3.0",
		"aws4fetch": "^1.0.20",
		"compression": "^1.8.2",
		"csv-parse": "^7.0.3",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"playwright": "^1.64.0",
		"postgres": "^3.4.9",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"serve-handler": "^6.1.7",
		"subset-font": "^2.9.0",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.3.0",
		"wrangler": "^4.97.0",
		"yaml": "^2.9.1",
		"zod": "^4.6.7"
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"dependencies": {
		"@fontsource-variable/big-shoulders-display": "^5.3.0",
		"@fontsource-variable/newsreader": "^5.3.0",
		"@fontsource-variable/outfit": "^5.3.0"
	}
}
