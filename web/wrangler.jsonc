{
	"$schema": "./node_modules/wrangler/config-schema.json",
	// The prep site. Prerendered pages and assets are Workers static assets, served with no Worker in
	// the path. The Worker answers what is left: the headshot image route and SvelteKit's 404.
	"name": "commish-web",
	"compatibility_date": "2026-10-12",
	"compatibility_flags": ["nodejs_als"],
	"main": ".svelte-kit/cloudflare/_worker.js",
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	// Cutover 2026-10-13 (founder: rip and replace): the apex and www are custom domains on this
	// Worker; wrangler keeps their DNS records. The workers.dev preview stays for checks.
	"routes": [
		{ "pattern": "trycommish.app", "custom_domain": true },
		{ "pattern": "www.trycommish.app", "custom_domain": true }
	],
	"workers_dev": true,
	"preview_urls": true,
	"observability": {
		"enabled": true
	}
}
