# Workers static assets read this file, which adapter-cloudflare merges into the build (Lane 21
# review, M2). Disney's sign-in widget for ESPN runs on these two pages only, and only on the
# workers.dev origin, which carries no Commish cookie (src/lib/site/origins.ts): scripts only from
# that origin and Disney's CDN, frames only Disney's (and our own responder page), connections only
# to that origin. The pages never call our API.
/espn-connect
  Content-Security-Policy: default-src 'none'; script-src 'self' https://cdn.registerdisney.go.com; style-src 'self' 'unsafe-inline' https://cdn.registerdisney.go.com; img-src 'self' data: https://cdn.registerdisney.go.com; font-src https://cdn.registerdisney.go.com; frame-src 'self' https://cdn.registerdisney.go.com https://*.registerdisney.go.com; connect-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff
/espn-connect.html
  Content-Security-Policy: default-src 'none'; script-src 'self' https://cdn.registerdisney.go.com; style-src 'self' 'unsafe-inline' https://cdn.registerdisney.go.com; img-src 'self' data: https://cdn.registerdisney.go.com; font-src https://cdn.registerdisney.go.com; frame-src 'self' https://cdn.registerdisney.go.com https://*.registerdisney.go.com; connect-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff
/espn-responder
  Content-Security-Policy: default-src 'none'; script-src 'self' https://cdn.registerdisney.go.com; connect-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'self'
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff
/espn-responder.html
  Content-Security-Policy: default-src 'none'; script-src 'self' https://cdn.registerdisney.go.com; connect-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'self'
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff

# Every page revalidates at the edge, and the deploy's stamp is never stored: Cloudflare's edge kept
# serving a removed page and the previous stamp after a deploy (ledger 2026-10-15), and the workflow
# now purges the zone after each deploy as well. adapter-cloudflare appends the rules that keep
# /_app/immutable/* cached for a year.
/*
  Cache-Control: no-cache
/data/run.txt
  ! Cache-Control
  Cache-Control: no-store

# The app's sign-in landing (Lane 172) is opened with a pairing code in its query: it sends no
# referrer and no cache keeps it, so the address goes nowhere past the browser.
/app/signed-in
  Referrer-Policy: no-referrer
  ! Cache-Control
  Cache-Control: no-store
/app/signed-in/*
  Referrer-Policy: no-referrer
  ! Cache-Control
  Cache-Control: no-store

# The app-link association files (Lane 172, scripts/well-known.ts): Apple's has no extension and
# both must answer as JSON for iOS and Android to verify the apps' links.
/.well-known/apple-app-site-association
  Content-Type: application/json
/.well-known/assetlinks.json
  Content-Type: application/json
