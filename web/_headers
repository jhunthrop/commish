# Workers static assets read this file, which adapter-cloudflare merges into the build (Lane 21 review, M2). Disney's sign-in widget for ESPN runs on
# these two pages only, never on a page of the site: scripts only from our origin and Disney's CDN,
# frames only Disney's (and our own responder page), connections only to our origin and our API.
/espn-connect
  Content-Security-Policy: default-src 'none'; script-src 'self' https://cdn.registerdisney.go.com; style-src 'self' 'unsafe-inline' https://cdn.registerdisney.go.com; img-src 'self' data: https://cdn.registerdisney.go.com; font-src https://cdn.registerdisney.go.com; frame-src 'self' https://cdn.registerdisney.go.com https://*.registerdisney.go.com; connect-src 'self' https://api.trycommish.app; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff
/espn-connect.html
  Content-Security-Policy: default-src 'none'; script-src 'self' https://cdn.registerdisney.go.com; style-src 'self' 'unsafe-inline' https://cdn.registerdisney.go.com; img-src 'self' data: https://cdn.registerdisney.go.com; font-src https://cdn.registerdisney.go.com; frame-src 'self' https://cdn.registerdisney.go.com https://*.registerdisney.go.com; connect-src 'self' https://api.trycommish.app; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff
/espn-responder
  Content-Security-Policy: default-src 'none'; script-src https://cdn.registerdisney.go.com; connect-src 'self' https://api.trycommish.app; base-uri 'none'; form-action 'none'; frame-ancestors 'self'
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff
/espn-responder.html
  Content-Security-Policy: default-src 'none'; script-src https://cdn.registerdisney.go.com; connect-src 'self' https://api.trycommish.app; base-uri 'none'; form-action 'none'; frame-ancestors 'self'
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff
