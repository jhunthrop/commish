{
	"ci": {
		"collect": {
			"startServerCommand": "npm run preview:static",
			"startServerReadyPattern": "Accepting connections",
			"url": ["http://localhost:4173/system", "http://localhost:4173/sheet"],
			"numberOfRuns": 7,
			"settings": {
				"preset": "perf",
				"formFactor": "mobile",
				"throttlingMethod": "devtools"
			}
		},
		"assert": {
			"assertMatrix": [
				{
					"matchingUrlPattern": "^https?://[^/]+/(system|board|players|record|clubs|adp)?(/.*)?$",
					"assertions": {
						"largest-contentful-paint": [
							"error",
							{
								"maxNumericValue": 1200
							}
						],
						"resource-summary:script:size": [
							"error",
							{
								"maxNumericValue": 61440
							}
						],
						"cumulative-layout-shift": [
							"error",
							{
								"maxNumericValue": 0.05
							}
						]
					},
					"aggregationMethod": "median"
				},
				{
					"matchingUrlPattern": "^https?://[^/]+/(sheet|mock|lobby|report|account|pass)(/.*)?$",
					"assertions": {
						"largest-contentful-paint": [
							"error",
							{
								"maxNumericValue": 2000
							}
						],
						"resource-summary:script:size": [
							"error",
							{
								"maxNumericValue": 184320
							}
						],
						"cumulative-layout-shift": [
							"error",
							{
								"maxNumericValue": 0.05
							}
						]
					},
					"aggregationMethod": "median"
				}
			]
		},
		"upload": {
			"target": "filesystem",
			"outputDir": ".lighthouseci"
		}
	}
}
