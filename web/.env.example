# The run the build prerenders. Copy to .env for local work.
# latest follows runs/latest.json, which the run's writer moves once a run passes its gates.
PUBLIC_RUN_ID=latest
# A local directory (relative to web/) holding runs/, written by npm run standin.
# In CI this is the bucket's https endpoint, set by scripts/r2-env.ts.
PUBLIC_RUN_BASE_URL=.runs
# The request API the user pages call. Unset, the build uses https://api.trycommish.app.
PUBLIC_API_URL=https://api.trycommish.app
