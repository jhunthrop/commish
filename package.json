{
  "name": "commish",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "tokens:build": "tsx scripts/gen-tokens-css.ts",
    "stats:generate": "tsx scripts/gen-mock-dataset.ts",
    "stats:tank01:record": "dotenv -e .env.local -- tsx scripts/record-tank01-fixtures.ts",
    "db:generate": "dotenv -e .env.local -- drizzle-kit generate",
    "db:migrate": "dotenv -e .env.local -v DATABASE_URL=postgres://commish:commish@localhost:5432/commish -- drizzle-kit migrate",
    "db:migrate:test": "dotenv -e .env.local -- sh -c 'DATABASE_URL=\"${TEST_DATABASE_URL:-postgres://commish:commish@localhost:5433/commish_test}\" drizzle-kit migrate'",
    "db:studio": "dotenv -e .env.local -- drizzle-kit studio",
    "seed": "dotenv -e .env.local -- tsx src/data/seed/index.ts",
    "stats:ingest": "dotenv -e .env.local -- tsx scripts/ingest-once.ts",
    "stats:adp": "dotenv -e .env.local -- tsx scripts/ingest-adp.ts",
    "stats:headshots": "dotenv -e .env.local -- tsx scripts/backfill-headshots.ts",
    "stats:correct": "dotenv -e .env.local -- tsx scripts/correct-stat-week.ts",
    "projections:report": "dotenv -e .env.local -- tsx scripts/projection-report.ts",
    "projections:backfill": "dotenv -e .env.local -- tsx scripts/projection-backfill.ts",
    "projections:fit": "dotenv -e .env.local -- tsx scripts/projection-fit.ts",
    "projections:ablate": "dotenv -e .env.local -- tsx scripts/projection-ablate.ts",
    "projections:context": "dotenv -e .env.local -- tsx scripts/projection-context.ts",
    "audit:verify": "dotenv -e .env.local -- tsx scripts/verify-audit-chain.ts",
    "reviews:remove": "dotenv -e .env.local -- tsx scripts/remove-review.ts",
    "admin:grant": "dotenv -e .env.local -- tsx scripts/grant-admin.ts",
    "integrity:sweep": "dotenv -e .env.local -- tsx scripts/sweep-multi-account.ts",
    "trades:sweep": "dotenv -e .env.local -- tsx scripts/sweep-trade-fairness.ts",
    "money:reconcile": "dotenv -e .env.local -- tsx scripts/money-reconcile.ts",
    "infra:up": "docker compose up -d --wait",
    "infra:down": "docker compose down",
    "e2e:build": "dotenv -e .env.local -v STATS_PROVIDER=mock -v NEXT_DIST_DIR=.next-e2e -- next build",
    "e2e": "npm run e2e:build && dotenv -e .env.local -v STATS_PROVIDER=mock -- playwright test",
    "e2e:ui": "npm run e2e:build && dotenv -e .env.local -v STATS_PROVIDER=mock -- playwright test --ui",
    "e2e:install": "playwright install --with-deps chromium",
    "projections:decisions": "dotenv -e .env.local -- tsx scripts/decision-report.ts",
    "projections:preseason:ingest": "dotenv -e .env.local -- tsx scripts/preseason-ingest.ts",
    "projections:preseason:fit": "dotenv -e .env.local -- tsx scripts/preseason-fit.ts",
    "projections:preseason": "dotenv -e .env.local -- tsx scripts/preseason-report.ts",
    "projections:preseason:diagnose": "dotenv -e .env.local -- tsx scripts/preseason-diagnose.ts",
    "projections:crosswalk": "dotenv -e .env.local -- tsx scripts/build-crosswalk.ts",
    "projections:ecr:current": "dotenv -e .env.local -- tsx scripts/ingest-current-ecr.ts",
    "projections:preseason:persist": "dotenv -e .env.local -- tsx scripts/preseason-persist.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.117.1",
    "@workos-inc/authkit-nextjs": "^4.3.1",
    "drizzle-orm": "^0.45.2",
    "ioredis": "^6.0.0",
    "lucide-react": "^1.31.0",
    "next": "15.5.23",
    "postgres": "^3.4.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.5",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^4.1.10",
    "@workos-inc/node": "^10.10.0",
    "axe-core": "^4.13.0",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "15.5.23",
    "eslint-plugin-functional": "^10.0.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "happy-dom": "^20.11.2",
    "iron-session": "^8.0.4",
    "playwright-core": "^1.62.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.10",
    "vitest-axe": "^0.1.0"
  }
}
