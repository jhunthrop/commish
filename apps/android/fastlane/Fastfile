# The Android app's release lane: the signed release bundle to Play's internal track. CI runs it on
# main only when the Play service account (PLAY_JSON_KEY) and the upload key are present; with them
# absent the workflow skips the step by name and stays green.
default_platform(:android)

platform :android do
  desc "Build the signed release bundle and upload it to the internal track"
  lane :internal do
    json_key = ENV.fetch("PLAY_JSON_KEY", "")
    UI.user_error!("PLAY_JSON_KEY is not set") if json_key.empty?
    UI.user_error!("ANDROID_KEYSTORE_PATH is not set") if ENV.fetch("ANDROID_KEYSTORE_PATH", "").empty?

    gradle(task: "bundle", build_type: "Release", project_dir: ".")
    upload_to_play_store(
      package_name: "app.trycommish.android",
      track: "internal",
      release_status: "draft",
      json_key_data: json_key,
      aab: lane_context[SharedValues::GRADLE_AAB_OUTPUT_PATH],
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      skip_upload_changelogs: true
    )
  end
end
