# Every variable the api, room and migrate commands read
# (internal/config). Copy to .env for a local run; production sets the
# plain ones on the Cloud Run service and the secret ones from Secret
# Manager (.github/workflows/api.yml).

# production | development. Production requires https origins and
# SESSION_COOKIE_DOMAIN, and marks cookies Secure.
APP_ENV=development
PORT=8080
PUBLIC_BASE_URL=http://localhost:5173
API_BASE_URL=http://localhost:8080
# Exact origins, comma-separated. Default: PUBLIC_BASE_URL, plus the
# SvelteKit dev server in development.
CORS_ORIGINS=
# How many proxies in front append to X-Forwarded-For. Cloud Run is one.
TRUSTED_PROXY_HOPS=1
# .trycommish.app in production, so the site and the API share the
# session. Empty is a host-only cookie, right for localhost.
SESSION_COOKIE_DOMAIN=

# Secret. The pooled Neon URL for the app; MIGRATE_DATABASE_URL may be
# the direct one for migrations and falls back to DATABASE_URL.
DATABASE_URL=postgres://commish:commish@localhost:5433/commish_test?sslmode=disable
MIGRATE_DATABASE_URL=

# WorkOS AuthKit. Secret: the API key and the cookie password (32+
# characters, seals the session cookie). The redirect URI defaults to
# API_BASE_URL/auth/callback and must be listed in the WorkOS dashboard.
WORKOS_CLIENT_ID=
WORKOS_API_KEY=
WORKOS_COOKIE_PASSWORD=
WORKOS_REDIRECT_URI=

# Stripe. Secret. Absent, billing answers 503. STRIPE_ENVIRONMENT must
# agree with the key's prefix.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_ENVIRONMENT=test
# true once Stripe Tax is set up on the account. Off, checkout charges no tax.
STRIPE_AUTOMATIC_TAX=false

# Cloudflare R2, the private exports bucket. Secret: the key pair.
# Absent, exports answer 503.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_EXPORTS_BUCKET=commish-exports
R2_ENDPOINT=

# Share links are signed. Secret, optional: keys of 32+ characters
# separated by spaces, newest first. The newest signs and every one
# verifies, so a rotation puts the new key first and keeps the old one
# until its links no longer matter. WORKOS_COOKIE_PASSWORD is always the
# last key, so unset this still signs, and rotating the cookie password
# without keeping the old one here breaks the links already shared.
SHARE_LINK_KEYS=

# Resend, for the renewal reminder job only. Secret.
RESEND_API_KEY=
MAIL_FROM=Commish <hello@trycommish.app>

# Development only, each refused in production. BILLING_FAKE sells through
# the in-memory gateway with a local checkout page at
# API_BASE_URL/billing/dev-checkout/<id> that delivers a signed event to the
# real webhook handler. COMPANION_REPLAY lets POST /companions take
# replay: true on the recorded Sleeper draft (internal/companion/replay),
# one pick a second with a hold at the drafter's turns.
BILLING_FAKE=false
COMPANION_REPLAY=false

# Connected host accounts (a member's FFPC sign-in) are envelope encrypted:
# each has its own data key, wrapped under this one. Secret, Secret Manager
# HOST_CREDENTIALS_KEY in production (required there): base64 of 32 random
# bytes, made with `openssl rand -base64 32`. Unset locally, connecting a
# host answers that it is not set up here. Never reuse a production key.
HOST_CREDENTIALS_KEY=
# The key's version (1 unless rotated), and during a rotation the key one
# version back, so the re-encrypt job can re-wrap rows (infra/README.md).
HOST_CREDENTIALS_KEY_VERSION=1
HOST_CREDENTIALS_KEY_PREVIOUS=
# The switch for FFPC: connect, the league poller, the refresh job, the
# companion and the web's FFPC choice. On unless false.
HOST_FFPC_ENABLED=true
