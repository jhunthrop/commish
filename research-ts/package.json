{
  "name": "@commish/research-ts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The TypeScript research core, kept as the parity oracle for the Python research lane and deleted after parity.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p .",
    "guard": "tsx scripts/guard-imports.ts",
    "nightly": "dotenv -e ../.env.local -- tsx src/nightly/main.ts",
    "inseason": "dotenv -e ../.env.local -- tsx src/inseason/main.ts",
    "advisor": "tsx src/advisor/server.ts",
    "db:generate": "dotenv -e ../.env.local -- drizzle-kit generate",
    "db:migrate": "dotenv -e ../.env.local -- drizzle-kit migrate",
    "advisor:measure": "tsx scripts/advisor-measure.ts"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "postgres": "^3.4.9",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
