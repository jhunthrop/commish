# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
# isolated build dir for e2e (see next.config.ts, playwright.config.ts) — a `next dev` sharing
# the default /.next/ would corrupt an e2e `next build`/`next start`'s asset manifest
/.next-e2e/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# minted dev session credentials (scripts/mint-dev-session.ts, e2e/global-setup.ts) — bearer
# cookies, never commit
.lab-session*.json
lab-session*.json
e2e/.auth/
playwright-report/
test-results/

# local databases (Phase 1 SQLite dev)
*.db
*.sqlite
*.sqlite3

# superpowers SDD scratch (ledgers, briefs, review packages)
.superpowers/

# Claude Code harness worktrees (nested checkouts — never commit, never lint/test)
.claude/worktrees/
