# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local databases (Phase 1 SQLite dev)
*.db
*.sqlite
*.sqlite3

# superpowers SDD scratch (ledgers, briefs, review packages)
.superpowers/

# Claude Code harness worktrees (nested checkouts — never commit, never lint/test)
.claude/worktrees/
