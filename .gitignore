# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
# isolated build dir for e2e (see next.config.ts, playwright.config.ts) — a `next dev` sharing
# the default /.next/ would corrupt an e2e `next build`/`next start`'s asset manifest
/.next-e2e/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# minted dev session credentials (scripts/mint-dev-session.ts, e2e/global-setup.ts) — bearer
# cookies, never commit
.lab-session*.json
lab-session*.json
# Anything a lab run writes. The two patterns above only cover the DEFAULT filename at the repo
# root, and a run that pointed `LAB_SESSION_FILE` at a directory of its own put a live sealed
# session cookie into three commits on 2026-08-28. Ignore the whole working directory,
# screenshots included: none of it is source.
.lab/
e2e/.auth/
playwright-report/
test-results/

# local databases (Phase 1 SQLite dev)
*.db
*.sqlite
*.sqlite3

# Firebase's Android client config (Lane 288): CI writes it from the GOOGLE_SERVICES_JSON secret.
apps/android/app/google-services.json

# superpowers SDD scratch (ledgers, briefs, review packages)
.superpowers/

# Claude Code harness worktrees (nested checkouts — never commit, never lint/test)
.claude/worktrees/
graphify-out/

# web (the SvelteKit prep site): dependencies, generated and local-only output
web/node_modules/
web/.svelte-kit/
web/build/
web/screenshots/

# compiled measurement tool, built on demand
api/roommeasure
